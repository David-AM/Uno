@UnoGame_HostAddress = http://localhost:5124

### Multiplayer demonstration lobby
GET {{UnoGame_HostAddress}}/api/lobby
Accept: application/json

### Join as the first player (the response contains PlayerId)
POST {{UnoGame_HostAddress}}/api/lobby/join
Content-Type: application/json

{
  "playerName": "Ada"
}

### Start after a second browser has joined
POST {{UnoGame_HostAddress}}/api/lobby/start
Content-Type: application/json

{
  "playerId": 1
}
